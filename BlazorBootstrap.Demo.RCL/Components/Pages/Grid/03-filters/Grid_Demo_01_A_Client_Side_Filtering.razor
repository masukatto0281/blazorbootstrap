    public record class Employee
    {
        public int? Id { get; set; }
        public string? Name { get; set; }
        public string? Designation { get; set; }
        public DateOnly? DOJ { get; set; }
        public bool IsActive { get; set; }
        public Department? Department { get; set; }
        public TestClass? Test { get; set; }
    }

    public record class Department
    {
        public int Id { get; set; }
        public string? Name { get; set; }
    }

    public record class TestClass
    {
        public int Int { get; set; }
        public int? IntNullable { get; set; }
        public string String { get; set; }
        public string? StringNullable { get; set; }
        public double Double { get; set; }
        public double? DoubleNullable { get; set; }
        public bool Bool { get; set; }
        public bool? BoolNullable { get; set; }
        public DateTime DateTime { get; set; }
        public DateTime? DateTimeNullable { get; set; }
        public DateOnly DateOnly { get; set; }
        public DateOnly? DateOnlyNullable { get; set; }
        public TimeOnly TimeOnly { get; set; }
        public TimeOnly? TimeOnlyNullable { get; set; }
        public Guid Guid { get; set; }
        public Guid? GuidNullable { get; set; }
        public TestEnum Enum { get; set; }
        public TestEnum? EnumNullable { get; set; }
    }

    public enum TestEnum
